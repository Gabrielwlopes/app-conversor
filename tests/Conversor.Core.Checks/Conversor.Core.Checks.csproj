<!--
  Testes do Conversor.Core. É um programa de console sem pacotes do NuGet, para rodar igual no computador e no
  GitHub Actions (comando: dotnet run, com o projeto tests/Conversor.Core.Checks).
  Termina com código 1 se algum teste falhar.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Conversor.Core\Conversor.Core.csproj" />
  </ItemGroup>
</Project>
